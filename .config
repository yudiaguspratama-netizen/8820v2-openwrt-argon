# Target System
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_zte_e8820v2=y

# Dasar Sistem & LuCI (Disederhanakan)
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-i18n-base-id=y

# Driver Switch MediaTek (Cukup satu kmod-mt7530 untuk 23.05)
CONFIG_PACKAGE_kmod-mt7530=y

# Driver WiFi (Gunakan kmod-mt76x2 untuk 5GHz pada E8820V2)
CONFIG_PACKAGE_kmod-mt7603=y
CONFIG_PACKAGE_kmod-mt76x2=y
CONFIG_PACKAGE_wpad-basic-wolfssl=y

# Optimization for 64MB RAM (PENTING)
CONFIG_PACKAGE_zram-swap=y
CONFIG_PACKAGE_kmod-zram=y
CONFIG_PACKAGE_nft-qos=y
CONFIG_PACKAGE_luci-app-nft-qos=y

# Force SSL Ringan (Mencegah Error 2 pada PPP/SSL)
CONFIG_PACKAGE_libustream-wolfssl=y
# CONFIG_PACKAGE_libustream-mbedtls is not set
# CONFIG_PACKAGE_libustream-openssl is not set

# Hapus ttyd jika tidak butuh terminal di browser (Hemat RAM)
# CONFIG_PACKAGE_luci-app-ttyd is not set
